APP_NAME=DubLok
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage and queue
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./storage/app.db
WORKER_POLL_SECONDS=2
JOB_TIMEOUT_SECONDS=7200
STAGE_MAX_RETRIES=1

# Input limits
MAX_UPLOAD_MB=750
MAX_DURATION_SECONDS=900
ALLOWED_URL_HOSTS=["youtube.com","www.youtube.com","youtu.be","drive.google.com"]

# Local model/runtime behavior
# production: use local open-source models; demo: deterministic placeholders for UI/dev tests only.
ENGINE_MODE=production
DEVICE=auto
MODEL_PRESET=balanced
HF_HOME=./storage/models/huggingface

# Audio defaults
BACKGROUND_MODE=full_replacement
ORIGINAL_VOLUME=0.20
TRANSLATED_VOLUME=1.00
SPEECH_SPEED=1.00

# Optional gated model access, still zero API cost.
# Set this only after accepting model terms on Hugging Face.
HUGGINGFACE_HUB_TOKEN=
